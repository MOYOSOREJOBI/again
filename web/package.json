{
  "name": "sentinel-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit --pretty false",
    "lint:fix": "tsc --noEmit --pretty false",
    "typecheck": "next build --no-lint && tsc --noEmit",
    "test": "rm -rf .tmp-tests && tsc -p tests/tsconfig.json && node --test .tmp-tests/tests/*.test.js .tmp-tests/tests/**/*.test.js",
    "test:watch": "npm run test"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "react-simple-maps": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "tailwindcss": "3.4.10",
    "@types/react": "18.3.3",
    "@types/node": "20.14.11"
  }
}